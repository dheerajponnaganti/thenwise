{
  "openapi": "3.1.0",
  "info": {
    "title": "Thenwise team server",
    "version": "1",
    "description": "API v1, frozen for the Hub. Every route but health, session and join takes `Authorization: Bearer <token>` or the tw_session cookie; writes with a cookie also send X-Thenwise-CSRF equal to the tw_csrf cookie. Errors are { error: { code, message } }. Roles, lowest to highest: viewer, member, editor, admin, owner; a refused call is 403 forbidden and is audited."
  },
  "paths": {
    "/v1/health": {
      "get": {"summary": "Liveness, schema version and the team's name.", "security": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}}
    },
    "/v1/session": {
      "post": {"summary": "Signs in with a token. Sets the cookies tw_session (httpOnly) and tw_csrf; writes from a session send tw_csrf's value in X-Thenwise-CSRF.", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionIn"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Member"}}}}, "401": {"$ref": "#/components/responses/Error"}}},
      "delete": {"summary": "Signs out and clears the cookies.", "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/join": {
      "post": {"summary": "Joins with an invite code and a name. Answers with the token, shown once; with `session: true` or Accept: text/html the cookies are set too.", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JoinIn"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Joined"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/me": {
      "get": {"summary": "The member the token or session belongs to.", "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Member"}}}}, "401": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/search": {
      "get": {"summary": "Full-text search over shared notes, best match first, with a snippet around the hit.", "parameters": [{"$ref": "#/components/parameters/q"}, {"$ref": "#/components/parameters/limit"}, {"$ref": "#/components/parameters/offset"}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NoteList"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/notes": {
      "get": {"summary": "Shared notes: newest first, or with since, every note changed after that revision in revision order (never a pending note).", "parameters": [{"$ref": "#/components/parameters/since"}, {"$ref": "#/components/parameters/limit"}, {"$ref": "#/components/parameters/offset"}, {"name": "owner", "in": "query", "description": "`me` or a member name", "schema": {"type": "string"}}, {"name": "project", "in": "query", "schema": {"type": "string"}}, {"name": "kind", "in": "query", "schema": {"enum": ["decision", "dead_end", "rule", "finding", "note"]}}, {"name": "status", "in": "query", "schema": {"enum": ["active", "retired", "superseded", "pending"]}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NoteList"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/notes/{owner}/{id}": {
      "get": {"summary": "One shared note in full. A read from a session is counted.", "parameters": [{"name": "owner", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "patch": {"summary": "Edits a note. If-Match is the revision read. Writes a revision. Needs the editor role.", "parameters": [{"name": "owner", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/ifMatch"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotePatch"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/notes/{owner}/{id}/revisions": {
      "get": {"summary": "Every revision of a note, newest first, with its text.", "parameters": [{"name": "owner", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/limit"}, {"$ref": "#/components/parameters/offset"}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevisionList"}}}}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/notes/{owner}/{id}/retire": {
      "post": {"summary": "Marks a note retired. Needs the editor role.", "parameters": [{"name": "owner", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/notes/{owner}/{id}/supersede": {
      "post": {"summary": "Marks a note superseded by another shared note (`by` is its id for the same owner, or owner/id). Needs the editor role.", "parameters": [{"name": "owner", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/id"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"by": {"type": "string"}}, "required": ["by"]}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/notes/{owner}/{id}/pin": {
      "post": {"summary": "Pins a note. Needs the editor role.", "parameters": [{"name": "owner", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/notes/{owner}/{id}/unpin": {
      "post": {"summary": "Unpins a note. Needs the editor role.", "parameters": [{"name": "owner", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/notes/{owner}/{id}/approve": {
      "post": {"summary": "Makes a pending note active (review queue). Needs the admin role.", "parameters": [{"name": "owner", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/id"}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Note"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/notes/{id}": {
      "put": {"summary": "Shares a note or a new version of it. If-Match is the revision last seen, or * for a note new to the team. kind, source and tags are optional. Needs the member role.", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/ifMatch"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NoteIn"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Rev"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"description": "Stale", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Stale"}}}}}},
      "delete": {"summary": "Unshares a note. A tomb records it for the feeds; its revisions and counts go. Needs the member role.", "parameters": [{"$ref": "#/components/parameters/id"}, {"$ref": "#/components/parameters/ifMatch"}, {"name": "seq", "in": "query", "schema": {"type": "integer"}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Rev"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"description": "Stale", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Stale"}}}}}}
    },
    "/v1/tombs": {
      "get": {"summary": "Unshares after a revision, in revision order.", "parameters": [{"$ref": "#/components/parameters/since"}, {"$ref": "#/components/parameters/limit"}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TombList"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/members": {
      "get": {"summary": "Everyone on the team. Needs the admin role.", "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemberList"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/members/{id}": {
      "patch": {"summary": "Changes a member's role, expiry or disabled flag. The owner cannot be changed. Needs the admin role.", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemberPatch"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Member"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}},
      "delete": {"summary": "Removes a member, keeping or deleting their notes. The owner cannot be removed. Needs the admin role.", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "notes", "in": "query", "required": true, "schema": {"enum": ["keep", "delete"]}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ok"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/members/{id}/rotate": {
      "post": {"summary": "Gives a member a new token, shown once. The old token and sessions stop at once. Needs the admin role.", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Token"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/members/{id}/make-owner": {
      "post": {"summary": "Hands the team over to another live member; the caller becomes an admin. Needs the owner role.", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Member"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/settings": {
      "get": {"summary": "The team's settings. Needs the admin role.", "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Settings"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}},
      "patch": {"summary": "Changes the team's name or the review queue. Needs the admin role.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"name": {"type": "string"}, "review_queue": {"type": "boolean"}}, "required": []}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Settings"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/invites": {
      "post": {"summary": "Creates an invite code, shown once. Needs the admin role.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InviteIn"}}}}, "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InviteOut"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/audit": {
      "get": {"summary": "The audit log, newest first. Needs the admin role.", "parameters": [{"$ref": "#/components/parameters/since"}, {"$ref": "#/components/parameters/limit"}, {"$ref": "#/components/parameters/offset"}, {"name": "actor", "in": "query", "description": "a member id", "schema": {"type": "string"}}, {"name": "action", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuditList"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/stats": {
      "get": {"summary": "Most-read notes and last seen, counts over the last 90 days. Nothing leaves the server. Needs the admin role.", "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Stats"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/export.zip": {
      "get": {"summary": "A zip of Markdown files in the vault format (one per note, an Index.md per project). Needs the editor role.", "responses": {"200": {"description": "A zip file", "content": {"application/zip": {"schema": {"type": "string", "format": "binary"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "token": {"type": "http", "scheme": "bearer"},
      "session": {"type": "apiKey", "in": "cookie", "name": "tw_session"}
    },
    "parameters": {
      "id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:#-]{0,119}$"}},
      "q": {"name": "q", "in": "query", "schema": {"type": "string"}},
      "limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200}},
      "offset": {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "since": {"name": "since", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "ifMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string"}}
    },
    "responses": {
      "Error": {"description": "An error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    },
    "schemas": {
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}},
      "Stale": {"type": "object", "required": ["error"], "properties": {"error": {"$ref": "#/components/schemas/Error/properties/error"}, "rev": {"type": ["integer", "null"]}, "updated_at": {"type": ["integer", "null"]}}},
      "Ok": {"type": "object", "properties": {"ok": {"type": "boolean"}}, "required": ["ok"]},
      "Health": {"type": "object", "properties": {"ok": {"type": "boolean"}, "schema": {"type": "integer"}, "version": {"type": "string"}, "team": {"type": "string"}}, "required": ["ok", "schema", "version", "team"]},
      "Member": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "role": {"enum": ["viewer", "member", "editor", "admin", "owner"]}, "expires_at": {"type": ["integer", "null"]}, "disabled": {"type": "boolean"}, "last_seen": {"type": ["integer", "null"]}, "created_at": {"type": "integer"}}, "required": ["id", "name", "role"]},
      "MemberList": {"type": "object", "properties": {"members": {"type": "array", "items": {"$ref": "#/components/schemas/Member"}}}, "required": ["members"]},
      "MemberPatch": {"type": "object", "properties": {"role": {"enum": ["viewer", "member", "editor", "admin"]}, "expires_at": {"type": ["integer", "null"]}, "disabled": {"type": "boolean"}}, "required": []},
      "Token": {"type": "object", "properties": {"token": {"type": "string"}}, "required": ["token"]},
      "SessionIn": {"type": "object", "properties": {"token": {"type": "string"}}, "required": ["token"]},
      "JoinIn": {"type": "object", "properties": {"code": {"type": "string"}, "name": {"type": "string"}, "session": {"type": "boolean"}}, "required": ["code", "name"]},
      "Joined": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "role": {"type": "string"}, "token": {"type": "string"}}, "required": ["id", "name", "role", "token"]},
      "InviteIn": {"type": "object", "properties": {"role": {"enum": ["viewer", "member", "editor", "admin"]}, "days": {"type": "integer", "minimum": 1, "maximum": 365}}, "required": []},
      "InviteOut": {"type": "object", "properties": {"code": {"type": "string"}, "role": {"type": "string"}, "expires_at": {"type": "integer"}}, "required": ["code", "role", "expires_at"]},
      "Settings": {"type": "object", "properties": {"name": {"type": "string"}, "review_queue": {"type": "boolean"}}, "required": ["name", "review_queue"]},
      "Rev": {"type": "object", "properties": {"rev": {"type": "integer"}}, "required": ["rev"]},
      "NoteIn": {"type": "object", "properties": {"title": {"type": "string"}, "text": {"type": "string"}, "project": {"type": "string"}, "seq": {"type": "integer"}, "kind": {"enum": ["decision", "dead_end", "rule", "finding", "note"]}, "source": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["title", "text", "project"]},
      "NotePatch": {"type": "object", "properties": {"title": {"type": "string"}, "text": {"type": "string"}, "project": {"type": "string"}, "kind": {"enum": ["decision", "dead_end", "rule", "finding", "note"]}, "source": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": []},
      "NoteBrief": {"type": "object", "properties": {"owner": {"type": "string"}, "id": {"type": "string"}, "rev": {"type": "integer"}, "title": {"type": "string"}, "project": {"type": "string"}, "updated_at": {"type": "integer"}, "created_at": {"type": "integer"}, "kind": {"enum": ["decision", "dead_end", "rule", "finding", "note"]}, "status": {"enum": ["active", "retired", "superseded", "pending"]}, "pinned": {"type": "boolean"}, "tags": {"type": "array", "items": {"type": "string"}}, "superseded_by": {"type": ["string", "null"]}, "shared_by": {"type": ["string", "null"]}, "source": {"type": "string"}, "snippet": {"type": "string"}}, "required": ["owner", "id", "rev", "title", "project", "updated_at", "created_at", "kind", "status", "pinned", "tags", "superseded_by", "shared_by", "source", "snippet"]},
      "Note": {"type": "object", "properties": {"owner": {"type": "string"}, "id": {"type": "string"}, "rev": {"type": "integer"}, "title": {"type": "string"}, "project": {"type": "string"}, "updated_at": {"type": "integer"}, "created_at": {"type": "integer"}, "kind": {"enum": ["decision", "dead_end", "rule", "finding", "note"]}, "status": {"enum": ["active", "retired", "superseded", "pending"]}, "pinned": {"type": "boolean"}, "tags": {"type": "array", "items": {"type": "string"}}, "superseded_by": {"type": ["string", "null"]}, "shared_by": {"type": ["string", "null"]}, "source": {"type": "string"}, "text": {"type": "string"}}, "required": ["owner", "id", "rev", "title", "project", "updated_at", "created_at", "kind", "status", "pinned", "tags", "superseded_by", "shared_by", "source", "text"]},
      "NoteList": {"type": "object", "properties": {"notes": {"type": "array", "items": {"$ref": "#/components/schemas/NoteBrief"}}}, "required": ["notes"]},
      "Revision": {"type": "object", "properties": {"rev": {"type": "integer"}, "title": {"type": "string"}, "text": {"type": "string"}, "kind": {"type": "string"}, "status": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}, "edited_by": {"type": ["string", "null"]}, "edited_by_name": {"type": "string"}, "edited_at": {"type": "integer"}}, "required": ["rev", "title", "text", "kind", "status", "tags", "edited_by", "edited_by_name", "edited_at"]},
      "RevisionList": {"type": "object", "properties": {"revisions": {"type": "array", "items": {"$ref": "#/components/schemas/Revision"}}}, "required": ["revisions"]},
      "TombList": {"type": "object", "properties": {"tombs": {"type": "array", "items": {"type": "object", "properties": {"owner": {"type": "string"}, "id": {"type": "string"}, "rev": {"type": "integer"}}, "required": ["owner", "id", "rev"]}}}, "required": ["tombs"]},
      "AuditList": {"type": "object", "properties": {"entries": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "integer"}, "at": {"type": "integer"}, "actor": {"type": ["string", "null"]}, "actor_name": {"type": ["string", "null"]}, "action": {"type": "string"}, "target": {"type": "string"}, "details": {"type": "object"}}, "required": ["id", "at", "actor", "actor_name", "action", "target", "details"]}}}, "required": ["entries"]},
      "Stats": {"type": "object", "properties": {"days": {"type": "integer"}, "top": {"type": "array", "items": {"type": "object", "properties": {"owner": {"type": "string"}, "id": {"type": "string"}, "title": {"type": "string"}, "reads": {"type": "integer"}}, "required": ["owner", "id", "title", "reads"]}}, "members": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "last_seen": {"type": ["integer", "null"]}}, "required": ["id", "name", "last_seen"]}}}, "required": ["days", "top", "members"]}
    }
  },
  "security": [{"token": []}, {"session": []}]
}
